#!/usr/bin/env bash
#
# pardus-code-pick SESSION
#
# Fuzzy-pick a file from the current project and open it in the nano pane of the
# given Pardus Code session. Invoked by the Ctrl-F binding inside a tmux popup.
#
# If the typed name matches no existing file, pressing Enter CREATES that file
# (and any parent directories) and opens the new, empty file in nano.
#
set -euo pipefail

# Resolve the tmux session this finder should drive.
#
# NOTE: tmux's `display-popup` does NOT expand `#{...}` formats in its command,
# so the Ctrl-F binding can't pass the session name as an argument — it would
# arrive as the literal string "#{session_name}". Instead we discover the
# session from inside the popup with `display-message`, which resolves against
# the client that opened us. An explicit, valid argument is honoured as an
# override (handy for testing).
session="${1:-}"
if [ -z "$session" ] || ! tmux has-session -t "$session" 2>/dev/null; then
  session="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
fi

# Still nothing usable means we're not running inside Pardus Code at all.
if [ -z "$session" ] || ! tmux has-session -t "$session" 2>/dev/null; then
  echo "pardus-code-pick is launched by Ctrl-F inside Pardus Code — it isn't a" >&2
  echo "standalone command. Start Pardus Code with 'pardus-code' and press" >&2
  echo "Ctrl-F to find or create files." >&2
  exit 1
fi

# --- build the candidate file list (fast, .git/node_modules excluded) -------
list_files() {
  if command -v fd >/dev/null 2>&1; then
    fd --type f --hidden --exclude .git --exclude node_modules
  else
    find . -type f \
      -not -path '*/.git/*' \
      -not -path '*/node_modules/*' \
      -printf '%P\n'
  fi
}

# We are ALREADY running inside a tmux popup. If the user's global fzf options
# enable tmux mode (`--tmux`, common in modern setups), fzf would try to open
# ANOTHER, nested tmux popup — which fails with tmux's "can't open window #(...)".
# Neutralise any inherited fzf config so fzf always runs inline in our popup,
# using only the explicit options below.
export FZF_DEFAULT_OPTS=""
unset FZF_DEFAULT_OPTS_FILE

# Collect the candidate list ONCE so we can feed fzf more than once if needed.
files="$(list_files)"

# fzf's stderr is logged so a flash-and-vanish popup leaves something to inspect.
log="${TMPDIR:-/tmp}/pardus-code-pick.log"
: > "$log"
run_fzf() { printf '%s\n' "$files" | fzf "$@" 2>>"$log"; }

# --print-query makes fzf echo the typed text as the FIRST output line, followed
# by the selected file (if any). That lets us tell "open existing" from "create".
# fzf exits non-zero when nothing matches, so don't let `set -e` kill us here.
set +e
out="$(run_fzf \
  --print-query \
  --prompt='open / create > ' \
  --layout=reverse \
  --border=rounded \
  --info=inline \
  --color='border:#F2C200,prompt:#F2C200,pointer:#F2C200,hl:#FFD43B,hl+:#FFD43B,query:#f6f1df' \
  --header='Pardus Code — type to filter, or type a new name + Enter to create')"
code=$?
# Exit 2 means fzf rejected an option (e.g. an older fzf that lacks a styling
# flag used above). Retry with only the essentials so the finder still works.
if [ "$code" -eq 2 ]; then
  out="$(run_fzf \
    --print-query \
    --prompt='open / create > ' \
    --header='Pardus Code: type to filter, or a new name + Enter to create')"
  code=$?
fi
set -e

# Ctrl-C / Esc -> abort, do nothing.
[ "$code" -eq 130 ] && exit 0

query="$(printf '%s\n' "$out" | sed -n '1p')"
choice="$(printf '%s\n' "$out" | sed -n '2p')"

# Prefer an explicit selection; otherwise fall back to the typed query as a new
# file name (this is the "no files / create" path).
file="${choice:-$query}"
[ -n "$file" ] || exit 0

# Strip any leading "./" the user might type.
file="${file#./}"

# Create the file if it doesn't exist yet (mkdir -p for nested paths).
created=0
if [ ! -e "$file" ]; then
  dir="$(dirname -- "$file")"
  [ "$dir" != "." ] && mkdir -p -- "$dir"
  : > "$file"
  created=1
fi

# --- find the pane currently running nano in this session -------------------
nano_pane="$(tmux list-panes -s -t "$session" \
  -F '#{pane_id} #{pane_current_command}' \
  | awk '$2 == "nano" { print $1; exit }')"

if [ -z "${nano_pane:-}" ]; then
  # nano isn't running (user may have quit it): respawn the right-hand pane.
  right_pane="$(tmux list-panes -s -t "$session" -F '#{pane_id}' | tail -n1)"
  tmux respawn-pane -k -t "$right_pane" "exec nano -- '$file'"
  tmux select-pane -t "$right_pane"
  exit 0
fi

# nano is running: open the file in a NEW buffer via Read-File (^R). The Pardus
# nanorc sets `set multibuffer`, so ^R loads into a fresh buffer (associated
# with this filename, so ^S saves to it) instead of inserting into the current.
tmux select-pane -t "$nano_pane"
tmux send-keys -t "$nano_pane" C-r
sleep 0.12
tmux send-keys -t "$nano_pane" -l "$file"
tmux send-keys -t "$nano_pane" Enter

[ "$created" -eq 1 ] && tmux display-message -t "$session" "Pardus Code: created $file"
exit 0
