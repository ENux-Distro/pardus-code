# ============================================================================
#  Pardus Code — GNU nano configuration  (loaded via: nano --rcfile)
#  Requires nano >= 5 for the named colour palette; tested on nano 9.
# ============================================================================

# --- editor behaviour -------------------------------------------------------
set linenumbers           # line numbers in the margin
set numbercolor cyan
set constantshow          # always show cursor position
set indicator             # scrollbar-style position indicator
set softwrap              # wrap long lines visually
set atblanks              # ...wrapping at word boundaries
set tabsize 4
set tabstospaces
set autoindent
set smarthome             # Home jumps to first non-blank, then column 0
set zap                   # let Backspace/Delete erase a selection
set mouse                 # mouse support (mirrors tmux)
set multibuffer           # ^R opens files in NEW buffers — used by Ctrl-F file find
set historylog            # remember search/replace history
set positionlog           # reopen files at the last cursor position
set minibar               # slim modern title/status bar
set stateflags            # show modified/autoindent flags in the minibar

# --- Pardus yellow / black / white theme ------------------------------------
set numbercolor    yellow                  # line numbers
set titlecolor     bold,black,yellow        # black text on a Pardus-yellow bar
set statuscolor    bold,black,yellow
set minicolor      bold,black,yellow
set promptcolor    bold,black,yellow
set selectedcolor  bold,black,yellow
set keycolor       brightyellow             # the ^X / ^S key labels
set functioncolor  white                    # their descriptions, in clean white
set errorcolor     bold,brightwhite,red
set stripecolor    ,#221                    # faint warm column guide
set scrollercolor  brightyellow
set spotlightcolor black,brightyellow        # search match highlight

# --- syntax highlighting ----------------------------------------------------
# Pull in the system-wide language definitions shipped with nano.
include "/usr/share/nano/*.nanorc"
# Extra community definitions, if the nano-extra package is installed.
include "/usr/share/nano/extra/*.nanorc"

# --- key bindings -----------------------------------------------------------
# Pardus Code reserves Ctrl-O / Ctrl-F / Ctrl-R at the tmux layer, so move the
# clashing nano actions onto comfortable alternatives:
bind ^S savefile  main     # save directly to the file, no prompt (no .save files)
bind ^Q exit      main     # quit        (in addition to Ctrl-X)
bind ^G gotoline  main     # go to line
bind M-/ comment  main     # toggle comment on the line/selection

# NOTE: ^R (Read File) and ^F are intentionally LEFT at their nano defaults.
# tmux already intercepts the user's physical Ctrl-R / Ctrl-F at the root level
# (for resize / file-find), so nano never sees those keypresses from the user.
# But Pardus Code's file finder drives nano via `tmux send-keys C-r` to open the
# chosen file in a new buffer — which only works while ^R stays bound here.
