#!/usr/bin/env bash
#
# Pardus Code — network installer.
#
#   curl -fsSL https://raw.githubusercontent.com/ENux-Distro/pardus-code/main/install | bash
#
# What it does:
#   1. installs the runtime deps (tmux, nano, fzf) when it can
#   2. downloads the Pardus Code source and the PARDUS-branded opencode binary
#   3. runs the bundled install.sh (per-user, into ~/.local by default)
#
# Tunables (env):
#   PARDUS_CODE_REPO    GitHub "owner/repo"            (default ENux-Distro/pardus-code)
#   PARDUS_CODE_REF     branch or tag of the source    (default main)
#   PARDUS_CODE_PREFIX  install prefix                  (default ~/.local; use /usr/local for system)
#   PARDUS_CODE_NO_DEPS set to 1 to skip apt dependency install
#
set -euo pipefail

REPO="${PARDUS_CODE_REPO:-ENux-Distro/pardus-code}"
REF="${PARDUS_CODE_REF:-main}"
PREFIX="${PARDUS_CODE_PREFIX:-$HOME/.local}"
BINARY_ASSET="opencode-linux-x64"

say()  { printf '\033[1;33m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- a download helper that works with curl or wget ------------------------
fetch() {  # fetch URL DEST
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    die "Need either curl or wget to download Pardus Code."
  fi
}

printf '\033[1;33m'
cat <<'BANNER'
  ____               _              ____          _
 |  _ \ __ _ _ __ __| |_   _ ___   / ___|___   __| | ___
 | |_) / _` | '__/ _` | | | / __| | |   / _ \ / _` |/ _ \
 |  __/ (_| | | | (_| | |_| \__ \ | |__| (_) | (_| |  __/
 |_|   \__,_|_|  \__,_|\__,_|___/  \____\___/ \__,_|\___|
BANNER
printf '\033[0m  opencode + nano, side by side.\n\n'

# --- arch check ------------------------------------------------------------
ARCH="$(uname -m)"
if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "amd64" ]; then
  err "The bundled PARDUS opencode binary is built for x86_64 (you have '$ARCH')."
  err "Install will continue and fall back to a system 'opencode' if present."
fi

# --- dependencies ----------------------------------------------------------
if [ "${PARDUS_CODE_NO_DEPS:-0}" != "1" ]; then
  need=()
  for c in tmux nano fzf; do command -v "$c" >/dev/null 2>&1 || need+=("$c"); done
  if [ "${#need[@]}" -gt 0 ]; then
    if command -v apt-get >/dev/null 2>&1; then
      say "Installing dependencies: ${need[*]}"
      sudo apt-get update -qq && sudo apt-get install -y "${need[@]}"
    else
      err "Please install these first: ${need[*]}"
    fi
  fi
fi

# --- workspace -------------------------------------------------------------
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

say "Downloading Pardus Code ($REPO@$REF)…"
fetch "https://github.com/$REPO/archive/refs/heads/$REF.tar.gz" "$TMP/src.tar.gz" \
  || fetch "https://github.com/$REPO/archive/refs/tags/$REF.tar.gz" "$TMP/src.tar.gz" \
  || die "Could not download source for $REPO@$REF."
tar -xzf "$TMP/src.tar.gz" -C "$TMP"
SRC="$(find "$TMP" -maxdepth 1 -type d -name 'pardus-code-*' | head -1)"
[ -n "$SRC" ] || die "Unexpected archive layout."

# --- the branded opencode binary (a Release asset) -------------------------
say "Downloading the PARDUS opencode binary…"
mkdir -p "$SRC/vendor"
if fetch "https://github.com/$REPO/releases/latest/download/$BINARY_ASSET" "$SRC/vendor/opencode"; then
  chmod +x "$SRC/vendor/opencode"
else
  err "Could not fetch the branded binary; Pardus Code will use a system 'opencode' if available."
  rm -f "$SRC/vendor/opencode"
fi

# --- install ---------------------------------------------------------------
say "Installing into $PREFIX …"
if [ "$PREFIX" = "/usr/local" ] || [ "$PREFIX" = "/usr" ]; then
  sudo "$SRC/install.sh" --prefix "$PREFIX"
else
  "$SRC/install.sh" --prefix "$PREFIX"
fi

echo
say "Done. Run:  pardus-code [directory]"
