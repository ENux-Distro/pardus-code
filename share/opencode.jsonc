{
  // ==========================================================================
  //  Pardus Code — opencode settings
  //  Layered OVER your existing global opencode config (auth/personal settings
  //  are preserved). The theme lives in pardus.tui.json.
  // ==========================================================================
  "$schema": "https://opencode.ai/config.json",

  // --- Free AI, no sign-up, no API key -------------------------------------
  // opencode's "OpenCode Zen" free models work anonymously: when you are not
  // logged in, opencode connects with a public key and only offers the free
  // (zero-cost) models. We pin one here so Pardus Code just works out of the
  // box — no `opencode auth login`, no model picker.
  //
  // Other free models you can switch to (run `opencode models` to see current):
  //   opencode/deepseek-v4-flash-free
  //   opencode/north-mini-code-free
  //   opencode/mimo-v2.5-free
  //   opencode/nemotron-3-ultra-free
  // If a pinned model is ever retired, swap this line for one of the above.
  "model": "opencode/big-pickle",

  // Want more/better models? `opencode auth login` (free account) unlocks them,
  // or add a local Ollama provider for fully offline use — but neither is
  // required for Pardus Code to work.

  "autoupdate": false
}
