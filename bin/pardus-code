#!/usr/bin/env bash
#
# Pardus Code — opencode + GNU nano, side by side, with a built-in AI agent.
#
#   pardus-code [DIRECTORY]
#
# Left pane : opencode (AI agent), themed for Pardus
# Right pane: GNU nano, themed for Pardus
#
# Shortcuts (no prefix needed):
#   Ctrl-R then arrow keys : resize the panes (Esc/Enter to leave resize mode)
#   Ctrl-O                 : swap the two panes (change side)
#   Ctrl-F                 : fuzzy-find a file and open it in nano
#
set -euo pipefail

# --- where our shared assets live ------------------------------------------
# Resolve relative to this script using the FHS layout:
#   <prefix>/bin/pardus-code  ->  <prefix>/share/pardus-code
# so the SAME launcher works whether installed under ~/.local, /usr or /usr/local.
# Override with PARDUS_CODE_HOME if you put the assets somewhere else.
if [ -z "${PARDUS_CODE_HOME:-}" ]; then
  SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  PARDUS_CODE_HOME="$(dirname "$(dirname "$SELF")")/share/pardus-code"
  [ -d "$PARDUS_CODE_HOME" ] || PARDUS_CODE_HOME="$HOME/.local/share/pardus-code"
fi
TMUX_CONF="$PARDUS_CODE_HOME/pardus.tmux.conf"
NANORC="$PARDUS_CODE_HOME/pardus.nanorc"
OPENCODE_PARDUS_CONFIG="$PARDUS_CODE_HOME/opencode.jsonc"
OPENCODE_PARDUS_TUI="$PARDUS_CODE_HOME/pardus.tui.json"

# --- localization (Turkish / English from the system locale) ----------------
. "$PARDUS_CODE_HOME/lang.sh" 2>/dev/null || {
  echo "Pardus Code: missing lang.sh — re-run install.sh." >&2; exit 1; }

# Welcome file in the user's language, if a translation is shipped.
WELCOME="$PARDUS_CODE_HOME/WELCOME.md"
[ "$PC_LANG" = "tr" ] && [ -f "$PARDUS_CODE_HOME/WELCOME.tr.md" ] && \
  WELCOME="$PARDUS_CODE_HOME/WELCOME.tr.md"

# --- pick the AI agent binary ----------------------------------------------
# Prefer the bundled PARDUS-branded opencode; otherwise use any opencode on
# PATH; otherwise the default location opencode's own installer uses.
BUNDLED_OPENCODE="$PARDUS_CODE_HOME/libexec/opencode"
if [ -x "$BUNDLED_OPENCODE" ]; then
  OPENCODE_BIN="$BUNDLED_OPENCODE"
elif command -v opencode >/dev/null 2>&1; then
  OPENCODE_BIN="$(command -v opencode)"
elif [ -x "$HOME/.opencode/bin/opencode" ]; then
  OPENCODE_BIN="$HOME/.opencode/bin/opencode"
else
  OPENCODE_BIN=""
fi

# --- dependency check -------------------------------------------------------
missing=()
for cmd in tmux nano fzf; do
  command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
[ -n "$OPENCODE_BIN" ] || missing+=("opencode")
if [ "${#missing[@]}" -gt 0 ]; then
  echo "$PC_MISSING_DEPS ${missing[*]}" >&2
  echo "$PC_INSTALL_HINT" >&2
  echo "  sudo apt install ${missing[*]/opencode/}" >&2
  echo "$PC_AGENT_HINT" >&2
  exit 1
fi

for asset in "$TMUX_CONF" "$NANORC" "$OPENCODE_PARDUS_CONFIG"; do
  if [ ! -f "$asset" ]; then
    printf "$PC_MISSING_ASSET_1 $PC_MISSING_ASSET_2\n" "$asset" >&2
    exit 1
  fi
done

# --- target project directory ----------------------------------------------
PROJECT_DIR="${1:-$PWD}"
if [ ! -d "$PROJECT_DIR" ]; then
  printf "$PC_NOT_A_DIR\n" "$PROJECT_DIR" >&2
  exit 1
fi
cd "$PROJECT_DIR"

# A file for nano to open on launch: prefer a project README, else the welcome.
NANO_TARGET="$WELCOME"
for candidate in README.md README readme.md; do
  if [ -f "$candidate" ]; then NANO_TARGET="$PWD/$candidate"; break; fi
done

# --- make the Pardus theme discoverable for this user -----------------------
# opencode finds custom themes in <config>/themes/*.json. We ship the theme in
# our shared assets and copy it into the user's config dir on first run, so a
# system-wide install (e.g. the .deb) still themes each user correctly.
USER_THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/themes"
SHARED_THEME="$PARDUS_CODE_HOME/themes/pardus.json"
if [ -f "$SHARED_THEME" ] && [ ! -f "$USER_THEME_DIR/pardus.json" ]; then
  mkdir -p "$USER_THEME_DIR"
  cp "$SHARED_THEME" "$USER_THEME_DIR/pardus.json"
fi

# --- layer the Pardus opencode config over the user's existing one ----------
# OPENCODE_CONFIG is merged on top of the global config, so the user's auth and
# personal settings are preserved; we only add the Pardus defaults.
export OPENCODE_CONFIG="$OPENCODE_PARDUS_CONFIG"
# Theme/keybinds live in the TUI config; this override only sets the theme and
# is merged over the user's global TUI prefs (auth is untouched).
[ -f "$OPENCODE_PARDUS_TUI" ] && export OPENCODE_TUI_CONFIG="$OPENCODE_PARDUS_TUI"

# --- build the tmux session -------------------------------------------------
SESSION="pardus-code-$$"

# Left pane (0): opencode. Right pane (1): nano with the Pardus rcfile.
tmux -f "$TMUX_CONF" new-session -d -s "$SESSION" -n editor "exec '$OPENCODE_BIN'"
tmux -f "$TMUX_CONF" set-environment -t "$SESSION" OPENCODE_CONFIG "$OPENCODE_CONFIG"
[ -n "${OPENCODE_TUI_CONFIG:-}" ] && \
  tmux -f "$TMUX_CONF" set-environment -t "$SESSION" OPENCODE_TUI_CONFIG "$OPENCODE_TUI_CONFIG"
tmux -f "$TMUX_CONF" split-window -h -t "$SESSION":0.0 \
  "exec nano --rcfile '$NANORC' -- '$NANO_TARGET'"

# opencode gets a touch more room than nano by default (60/40).
tmux -f "$TMUX_CONF" resize-pane -t "$SESSION":0.0 -x 60%
# Start focused on the AI agent.
tmux -f "$TMUX_CONF" select-pane -t "$SESSION":0.0
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pardus_session "$SESSION"

# Localize the tmux status bar + messages for this session (English defaults
# live in the config; these override with the locale's strings from lang.sh).
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_resize     "$PC_TMUX_RESIZE"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_swap       "$PC_TMUX_SWAP"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_find       "$PC_TMUX_FIND"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_term       "$PC_TMUX_TERM"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_swapped    "$PC_TMUX_SWAPPED"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_resizemode "$PC_TMUX_RESIZEMODE"
tmux -f "$TMUX_CONF" set-option -t "$SESSION" @pc_resizedone "$PC_TMUX_RESIZEDONE"

exec tmux -f "$TMUX_CONF" attach-session -t "$SESSION"
