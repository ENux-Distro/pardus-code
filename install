#!/usr/bin/env bash
#
# Pardus Code — network installer.
#
#   curl -fsSL https://raw.githubusercontent.com/ENux-Distro/pardus-code/main/install | bash
#
# What it does:
#   1. installs the deps it needs (git, tmux, nano, fzf, curl, unzip) when it can
#   2. git-clones the Pardus Code repo, then COMPILES the PARDUS-branded opencode
#      from the fork (installs the bun toolchain, clones the fork, builds it)
#   3. runs the repo's install.sh (per-user, into ~/.local by default)
#
# Tunables (env):
#   PARDUS_CODE_REPO    GitHub "owner/repo"            (default ENux-Distro/pardus-code)
#   PARDUS_CODE_REF     branch or tag of the source    (default main)
#   PARDUS_CODE_PREFIX  install prefix                  (default ~/.local; use /usr/local for system)
#   PARDUS_CODE_NO_DEPS set to 1 to skip apt dependency install
#   OPENCODE_FORK       opencode fork to build (default https://github.com/ENux-Distro/opencode.git)
#   OPENCODE_FORK_REF   branch/tag of the fork to build (default dev)
#

set -euo pipefail

REPO="${PARDUS_CODE_REPO:-ENux-Distro/pardus-code}"
REF="${PARDUS_CODE_REF:-main}"
PREFIX="${PARDUS_CODE_PREFIX:-$HOME/.local}"

say()  { printf '\033[1;33m::\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- a download helper that works with curl or wget ------------------------
fetch() {  # fetch URL DEST
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    die "Need either curl or wget to download Pardus Code."
  fi
}

printf '\033[1;33m'
cat <<'BANNER'
  ____               _              ____          _
 |  _ \ __ _ _ __ __| |_   _ ___   / ___|___   __| | ___
 | |_) / _` | '__/ _` | | | / __| | |   / _ \ / _` |/ _ \
 |  __/ (_| | | | (_| | |_| \__ \ | |__| (_) | (_| |  __/
 |_|   \__,_|_|  \__,_|\__,_|___/  \____\___/ \__,_|\___|
BANNER
printf '\033[0m  opencode + nano, side by side.\n\n'

# --- arch check ------------------------------------------------------------
ARCH="$(uname -m)"
if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "amd64" ]; then
  err "The bundled PARDUS opencode binary is built for x86_64 (you have '$ARCH')."
  err "Install will continue and fall back to a system 'opencode' if present."
fi

# --- dependencies ----------------------------------------------------------
# git is needed to clone the repo; tmux/nano/fzf are the runtime deps;
# build-essential (gcc/g++/make) and nodejs are needed to compile the branded
# opencode binary (bun's build needs a C toolchain, plus node for some of the
# fork's build scripts). node-gyp is needed too: some of the fork's native
# addons (e.g. tree-sitter-powershell) run "node-gyp rebuild" as an install
# script, and unlike npm, bun does not bundle node-gyp itself.
if [ "${PARDUS_CODE_NO_DEPS:-0}" != "1" ]; then
  need=()
  for c in git tmux nano fzf curl unzip; do command -v "$c" >/dev/null 2>&1 || need+=("$c"); done
  { command -v gcc >/dev/null 2>&1 && command -v g++ >/dev/null 2>&1 && command -v make >/dev/null 2>&1; } \
    || need+=("build-essential")
  command -v node >/dev/null 2>&1 || need+=("nodejs")
  command -v node-gyp >/dev/null 2>&1 || need+=("node-gyp")
  if [ "${#need[@]}" -gt 0 ]; then
    if command -v apt-get >/dev/null 2>&1; then
      say "Installing dependencies: ${need[*]}"
      sudo apt-get update -qq && sudo apt-get install -y "${need[@]}"
    else
      err "Please install these first: ${need[*]}"
    fi
  fi
fi
command -v git >/dev/null 2>&1 || die "git is required to install Pardus Code."

# --- workspace -------------------------------------------------------------
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

say "Cloning Pardus Code ($REPO@$REF)…"
SRC="$TMP/pardus-code"
git clone --depth 1 --branch "$REF" "https://github.com/$REPO.git" "$SRC" 2>/dev/null \
  || git clone --depth 1 "https://github.com/$REPO.git" "$SRC" \
  || die "Could not clone https://github.com/$REPO (check the repo name / network)."

# --- compile the PARDUS-branded opencode from the fork ---------------------
say "Building the PARDUS opencode binary from source (first run takes a while)…"
if "$SRC/packaging/build-opencode.sh" "$SRC/vendor/opencode"; then
  :
else
  rm -f "$SRC/vendor/opencode"
  err "Could not build the branded opencode — falling back to upstream opencode."
  err "(You still get free AI with no login; just the stock 'opencode' logo.)"
  if ! command -v opencode >/dev/null 2>&1 && [ ! -x "$HOME/.opencode/bin/opencode" ]; then
    curl -fsSL https://opencode.ai/install | bash \
      || err "Upstream opencode install failed; install it manually from https://opencode.ai"
  fi
fi

# --- install ---------------------------------------------------------------
say "Installing into $PREFIX …"
if [ "$PREFIX" = "/usr/local" ] || [ "$PREFIX" = "/usr" ]; then
  sudo "$SRC/install.sh" --prefix "$PREFIX"
else
  "$SRC/install.sh" --prefix "$PREFIX"
fi

echo
say "Done. Run:  pardus-code [directory]"
